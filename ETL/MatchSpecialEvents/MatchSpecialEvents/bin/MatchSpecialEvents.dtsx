<DTS:Property DTS:Name="IncludeInDebugDump">2345</DTS:Property><DTS:VariableValue DTS:DataType="8">SELECT IDSportsTicker SportsTickerID     ,CoverageID     ,PlayStateID     ,StadiumID     ,[dateTime]     ,neutralGround     ,scoutConfirmed     ,booked     ,sportId     ,Leagueid     ,Matchid     ,IBCHomeId     ,IBCAwayId     ,ConfirmStatus     ,ConfirmUser     ,ConfirmUserName     ,ConfirmTime     ,CASE WHEN DB_NAME() IN( 'Betradar', 'Betradar_bk' ) THEN 'Betradar'      WHEN DB_NAME() ='RTS' THEN 'RTS'      WHEN DB_NAME() IN( 'RBall','RBall_bk') AND rs.IDSportsTicker&gt;100000000 THEN 'RBall'      ELSE 'IPSD' END DataSoure    FROM dbo.@@###@@ sp WITH(NOLOCK)    WHERE sp.Matchid IN SELECT IDSportsTicker SportsTickerID     ,CoverageID     ,PlayStateID     ,StadiumID     ,[dateTime]     ,neutralGround     ,scoutConfirmed     ,booked     ,sportId     ,Leagueid     ,Matchid     ,IBCHomeId     ,IBCAwayId     ,ConfirmStatus     ,ConfirmUser     ,ConfirmUserName     ,ConfirmTime     ,CASE WHEN DB_NAME() IN( 'Betradar', 'Betradar_bk' ) THEN 'Betradar'      WHEN DB_NAME() ='RTS' THEN 'RTS'      WHEN DB_NAME() IN( 'RBall','RBall_bk') AND rs.IDSportsTicker&gt;100000000 THEN 'RBall'      ELSE 'IPSD' END DataSoure    FROM dbo.SportsTicker sp WITH(NOLOCK)  </DTS:VariableValue>
