<properties>
<property id="350" name="CommandTimeout" dataType="System.Int32" state="default" isArray="false" description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out." typeConverter="" UITypeEditor="" containsID="false" expressionType="None">0</property>
<property id="351" name="OpenRowset" dataType="System.String" state="default" isArray="false" description="Specifies the name of the database object used to open a rowset." typeConverter="" UITypeEditor="" containsID="false" expressionType="None"></property>
<property id="352" name="OpenRowsetVariable" dataType="System.String" state="default" isArray="false" description="Specifies the variable that contains the name of the database object used to open a rowset." typeConverter="" UITypeEditor="" containsID="false" expressionType="None"></property>
<property id="353" name="SqlCommand" dataType="System.String" state="default" isArray="false" description="The SQL command to be executed." typeConverter="" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" containsID="false" expressionType="None">SELECT NULL AS CustomerCategory
		,b.transid refno
		,b.winlostdate
		,CONVERT(VARCHAR(1),b.betfrom) betfrom
		,0 liveindicator
		,b.GameID bettype
		,b.custid
		,NULL betteam
		,b.stake
		,b.actual_stake
		,b.odds
		,b.winlost
		,b.awinlost
		,b.mwinlost
		,b.swinlost
		,b.acomm
		,b.scomm
		,b.playercomm
		,b.comm
		,b.tpositiontaking
		,b.spositiontaking
		,b.mpositiontaking
		,b.apositiontaking
		,b.ProductID matchid
		,CONVERT(VARCHAR(15),b.STATUS) status
		,b.srecommend
		,b.actualrate AS actualrate
		,b.currency
		,CASE 
			WHEN stake &lt; 0 THEN 1
			ELSE 0
			END AS ExternalBet
		,b.recommend
		,b.mrecommend
		,b.actualrate AS transdaterate
		,b.refno transid
		,b.virtualrate
		,b.transdate
		,0 AS isBA
		,0 livehomescore
		,0 liveawayscore
		,NULL oddsspread
		,0 betcheck
		,0 hdp1
		,0 hdp2
		,CONVERT([varchar](15),b.[IP]) [IP]
		,NULL modds
		,NULL ContributionRate
		,NULL ContributionStake3rd		
		,0 OddsType
		,1 BetCount
		,0.0 Insurance
		,null BetID
		,null ExtraInfo
,ISNULL([epositiontaking],0)  [epositiontaking]
	FROM bodb02.dbo.bettransLC AS b WITH (NOLOCK)

			INNER JOIN bodb02.dbo.vw_Customer cu (NOLOCK)
				ON b.custid = cu.custid
			INNER JOIN bodb02.dbo.CS_CustSuper cn88 (NOLOCK)
				ON cn88.CustId = cu.srecommend	
	WHERE (
			b.winlostdate &gt;= ?
			AND b.winlostdate &lt;= ?
			)
		AND b.GameId IN (1801,1802,1803,1804,2401,2402,2403,2404,2405,2406)
		
		AND (b.StatusID IN (111,112, 113, 103, 101, 102));</property>
<property id="354" name="SqlCommandVariable" dataType="System.String" state="default" isArray="false" description="The variable that contains the SQL command to be executed." typeConverter="" UITypeEditor="" containsID="false" expressionType="None"></property>
