<components>
<component id="1" name="OLE DB Source" componentClassID="{BCEFE59B-6819-47F7-A125-63753B33ABB7}" description="OLE DB Source" localeId="-1" usesDispositions="true" validateExternalMetadata="True" version="7" pipelineVersion="0" contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SqlServer v10; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7">
<properties>
<property id="2" name="CommandTimeout" dataType="System.Int32" state="default" isArray="false" description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out." typeConverter="" UITypeEditor="" containsID="false" expressionType="None">0</property>
<property id="3" name="OpenRowset" dataType="System.String" state="default" isArray="false" description="Specifies the name of the database object used to open a rowset." typeConverter="" UITypeEditor="" containsID="false" expressionType="None"></property>
<property id="4" name="OpenRowsetVariable" dataType="System.String" state="default" isArray="false" description="Specifies the variable that contains the name of the database object used to open a rowset." typeConverter="" UITypeEditor="" containsID="false" expressionType="None"></property>
<property id="5" name="SqlCommand" dataType="System.String" state="default" isArray="false" description="The SQL command to be executed." typeConverter="" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" containsID="false" expressionType="None">SELECT NULL AS CustomerCategory
		,b.transid
		,b.winlostdate
		,CONVERT(VARCHAR(1),b.betfrom) betfrom
		,ISNULL(b.liveindicator, 0) liveindicator
		,b.bettype
		,b.custid
		,CASE WHEN b.bettype = 18000 THEN CONVERT([varchar](10),b.currency2) ELSE CONVERT([varchar](10),b.betteam) END AS betteam
		,b.stake
		,b.actual_stake
		,b.odds
		,b.winlost
		,b.awinlost
		,b.mwinlost + CASE 
			WHEN b.bettype IN (31,32,33,41,42,43) THEN b.swinlost
			ELSE 0
			END AS mwinlost
		,CASE 
			WHEN b.bettype IN (31,32,33,41,42,43) THEN (winlost - stake) * (1 - tpositiontaking - ISNULL(oddsspread, 0))
			ELSE b.swinlost
			END AS swinlost
		,b.acomm
		,b.scomm
		,b.playercomm
		,b.comm
		,CASE 
			WHEN b.bettype IN (31,32,33,41,42,43) THEN 1 - ISNULL(oddsspread, 0)
			ELSE b.tpositiontaking
			END AS tpositiontaking
		,b.spositiontaking
		,b.mpositiontaking
		,b.apositiontaking
		,CASE WHEN b.bettype=1003 THEN b.betdaqid ELSE b.matchID END AS matchid		
		,CASE 
			WHEN (
					b.bettype IN (1, 3, 7, 8, 17, 18, 124, 125, 482, 483, 484, 485)
					AND ABS(b.modds) = 0.25
					AND b.[statusID] IN (112,113)
					)
				OR (
					b.bettype IN (33, 43)
					AND b.[statusID] &lt;&gt; 103
					AND b.liveawayscore = 0
					) THEN CONVERT(VARCHAR(15),'HALF ' + b.STATUS)
			ELSE CONVERT(VARCHAR(15),b.STATUS)
			END AS [status]
		,b.srecommend
		,b.actualrate AS actualrate
		,b.currency
		,CASE 
			WHEN b.stake &lt; 0 THEN 1
			ELSE 0
			END AS ExternalBet
		,b.recommend
		,b.mrecommend
		,b.actualrate AS transdaterate
		,b.refno
		,b.virtualrate
		,b.transdate
		,0 AS isBA
		,b.livehomescore
		,b.liveawayscore
		,b.oddsspread
		,CONVERT([varchar](50),b.betcheck) betcheck
		,b.hdp1
		,b.hdp2
		,CONVERT([varchar](15),b.[IP]) [IP]
		,b.modds
		,NULL ContributionRate
		,NULL ContributionStake3rd
		,ISNULL(CONVERT(INT,b.OddsType),-1) OddsType
		,CASE WHEN b.Bettype BETWEEN 1401 AND 1499 THEN b.BetID ELSE 1 END AS BetCount
		,CASE WHEN b.Bettype BETWEEN 1401 AND 1499 THEN ISNULL(TransID2,0) /10000.0 ELSE 0 END AS Insurance
		,b.BetID
		,b.ExtraInfo
,ISNULL([epositiontaking],0)  [epositiontaking]
	FROM bodb02.dbo.bettrans AS b WITH (NOLOCK) 
			INNER JOIN bodb02.dbo.match bk (NOLOCK)
				ON b.matchid = bk.matchid	 AND bk.Sporttype =1
			 LEFT JOIN bodb02.dbo.League l (NOLOCK)
						ON l.LeagueID = bk.LeagueID
	WHERE (
			b.winlostdate &gt;=?
			AND b.winlostdate &lt;= ?
			)
		AND (b.custid &gt; 0)
		--AND b.liveindicator = 1

		--AND LeagueID IN   (3,4,5,43,7031,1568,1837)
		AND  ISNULL(l.LeagueGroupID,-1)NOT IN (42,74)
		AND (b.bettype &lt; 19999)
		AND b.bettype NOT IN (1011,1801,1802,1803,1804,1901,2008,2009,2101,2102,2103,2104,2105,2106,2107,2108,2109,2110,2111,2112,2113,2114,2115,2116,2117,2118,2119,2120,2121,2122,2123,2124,2125,2126,2127,2128,2129,2130,2131,2132,2133,2134,2135,2136,2137,2138,2139,2140,2141,2142,2143,2144,2145,2146,2147,2148,2149,2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2198,2199,2201,2202,2203,2204,2205,2206,2207,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2319,2320,2321,2398,2399,2401,2402,2403,2404,2405,2406,2901,2902,2903,2904,2905,2906,2907,2908,2909,2910,2911,2912,2913,2914,2915,2916,2919,2920,2921,2998,2999,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141,4142,4143,4144,4145,4146,4147,4148,4149,4150,4151,4152,4153,4154,4155,4156,4157,4158,4159,4160,4161,4162,4163,4164,4165,4166,4167,4168,4169,4170,4171,4172,4173,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4300,901,902,911,912)

		AND (b.statusID NOT IN (121,0,1))
		AND b.ruben = 1
                              -- and b.matchid =35971132
		;</property>
